@model List<ITI_ASP.NET.Models.Instructor>

<h1>All Instructors</h1>
<a asp-controller="Instructor" asp-action="Create">
    Add Instructor
</a>

@foreach (var instructor in Model)
{
    <div>
        <h2>@instructor.Name</h2>

        <img src="~/images/@instructor.Image"
             alt="@instructor.Name"
             width="150" />

        <p>Department: @instructor.Department.Name</p>
        <p>Course: @instructor.Course.Name</p>

        <a asp-controller="Instructor"
           asp-action="Edit"
           asp-route-id="@instructor.Id">
            Edit
        </a>

        <a asp-controller="Instructor"
           asp-action="Delete"
           asp-route-id="@instructor.Id">
            Delete
        </a>
    </div>

    <hr />
}