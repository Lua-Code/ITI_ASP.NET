@model ITI_ASP.NET.Models.Instructor

<h1>Delete Instructor</h1>

<p>Are you sure you want to delete this instructor?</p>

<h2>@Model.Name</h2>

<p>Email: @Model.Email</p>
<p>Phone: @Model.PhoneNumber</p>
<p>Salary: @Model.Salary</p>

<form asp-controller="Instructor"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit">
        Yes, Delete
    </button>

</form>

<a asp-controller="Instructor"
   asp-action="ShowAll">
    Cancel
</a>