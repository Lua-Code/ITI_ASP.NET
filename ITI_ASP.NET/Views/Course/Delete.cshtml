@model ITI_ASP.NET.Models.Course

<h1>Delete Course</h1>

<p>Are you sure you want to delete this course?</p>

<h2>@Model.Name</h2>

<p>Degree: @Model.Degree</p>
<p>Minimum Degree: @Model.MinDegree</p>
<p>Course Hours: @Model.CourseHours</p>

<form asp-controller="Course"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit">
        Yes, Delete
    </button>

</form>

<a asp-controller="Course"
   asp-action="ShowAll">
    Cancel
</a>