@model ITI_ASP.NET.Models.CourseResult

<h1>Delete Course Result</h1>

<p>Are you sure you want to delete this course result?</p>

<h2>Result @Model.Id</h2>

<p>Degree: @Model.Degree</p>

<form asp-controller="CourseResult"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit">
        Yes, Delete
    </button>

</form>

<a asp-controller="CourseResult"
   asp-action="ShowAll">
    Cancel
</a>