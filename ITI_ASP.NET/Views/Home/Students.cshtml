@model List<string>

@{
    ViewData["Title"] = "Students";
}

<h1>Student List</h1>

@if (Model.Count > 0)
{
    <p>There are @Model.Count students.</p>

    <ul>
        @foreach (var student in Model)
        {
            <li>@student</li>
        }
    </ul>
}
else
{
    <p>No students found.</p>
}