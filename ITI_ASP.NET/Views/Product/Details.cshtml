@model ITI_ASP.NET.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<a asp-action="ShowAllProducts">
    <button>Back</button>
</a>

<h1>Product Details</h1>

<img src="~/images/@Model.Image" alt="@Model.Name" width="300" />

<h2>@Model.Name</h2>

<p><strong>ID:</strong> @Model.ID</p>

<p><strong>Description:</strong> @Model.Description</p>

<p><strong>Price:</strong> @Model.Price EGP</p>

<p><strong>Category:</strong> @Model.Category</p>

<p><strong>Brand:</strong> @Model.Brand</p>

<p><strong>Stock:</strong> @Model.Stock</p>

<p><strong>Rating:</strong> @Model.Rating</p>

<p>
    <strong>Available:</strong>

    @if (Model.IsAvailable)
    {
        <span>Yes</span>
    }
    else
    {
        <span>No</span>
    }
</p>