@model ITI_ASP.NET.Models.Trainee

<h1>Delete Trainee</h1>

<p>Are you sure you want to delete this trainee?</p>

<h2>@Model.Name</h2>

<p>Phone: @Model.PhoneNumber</p>
<p>Grade: @Model.Grade</p>

<form asp-controller="Trainee"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit">
        Yes, Delete
    </button>

</form>

<a asp-controller="Trainee"
   asp-action="ShowAll">
    Cancel
</a>