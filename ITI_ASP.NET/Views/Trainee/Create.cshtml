@model ITI_ASP.NET.Models.Trainee

<h1>Create Trainee</h1>

<form asp-controller="Trainee" asp-action="Create" method="post">

    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
    </div>

    <div>
        <label asp-for="Image"></label>
        <input asp-for="Image" />
    </div>

    <div>
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" />
    </div>

    <div>
        <label asp-for="Grade"></label>
        <input asp-for="Grade" />
    </div>

    <div>
        <label asp-for="DepartmentId"></label>

        <select asp-for="DepartmentId">
            @foreach (var department in ViewBag.Departments)
            {
                <option value="@department.Id">
                    @department.Name
                </option>
            }
        </select>
    </div>

    <button type="submit">Create</button>

</form>

<a asp-controller="Trainee" asp-action="ShowAll">
    Back to Trainees
</a>