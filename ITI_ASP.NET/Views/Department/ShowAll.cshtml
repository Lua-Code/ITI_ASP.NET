@model List<ITI_ASP.NET.Models.Department>

<h1>All Departments</h1>
<a asp-controller="Department" asp-action="Create">
    Add Department
</a>

@foreach (var department in Model)
{
    <div>
        <h2>@department.Name</h2>

        <p>
            Trainees: @department.Trainees.Count
        </p>

        <a asp-controller="Department"
           asp-action="Details"
           asp-route-id="@department.Id">
            Details
        </a>

        <a asp-controller="Department"
           asp-action="Edit"
           asp-route-id="@department.Id">
            Edit
        </a>

        <a asp-controller="Department"
           asp-action="Delete"
           asp-route-id="@department.Id">
            Delete
        </a>
    </div>

    <hr />
}s