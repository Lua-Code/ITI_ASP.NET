@model ITI_ASP.NET.Models.Department

<h1>Delete Department</h1>

<p>Are you sure you want to delete this department?</p>

<h2>@Model.Name</h2>

<p>Manager: @Model.Manager</p>

<form asp-controller="Department"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit">
        Yes, Delete
    </button>

</form>

<a asp-controller="Department"
   asp-action="ShowAll">
    Cancel
</a>